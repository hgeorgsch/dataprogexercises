   editor = {de Werra, Dominique and Parlier, Greg H.  and Vitoriano, Bego{\~{n}}a},
   journal = {Communications in Computer and Information Science},
   year = 2015,
publisher="Springer International Publishing",
pages="165--190",
abstract="Tug fleet optimisation algorithms can be designed to solve the problem of dynamically positioning a fleet of tugs in order to mitigate the risk of oil tanker drifting accidents. In this paper, we define the 1D tug fleet optimisation problem and present a receding horizon genetic algorithm for solving it. The algorithm can be configured with a set of cost functions such that each configuration effectively constitute a unique tug fleet optimisation algorithm. To measure the performance, or merit, of such algorithms, we propose two evaluation heuristics and test them by means of a computational simulation study. Finally, we discuss our findings and some of our related work on a parallel implementation and an alternative 2D nonlinear mixed integer programming formulation of the problem.",
isbn="978-3-319-27680-9",
doi = {10.1007/978-3-319-27680-9_11},
url = {https://www.researchgate.net/profile/Robin-Bye/publication/295402617_A_simulation_study_of_evaluation_heuristics_for_tug_fleet_optimisation_problems/links/5a61b66e4585158bca4a130f/A-simulation-study-of-evaluation-heuristics-for-tug-fleet-optimisation-problems.pdf},
