    "saldoer_ny_rente = saldo_over_tid(månedlig_sparing_ny, måneder_1, rente_3)\n",
    "\n",
    "# Tekstutskrifter\n",
    "print(f\"Du må spare {månedlig_sparing_1:.2f} kr per måned for å nå 1 000 000 kr innen 10 år med 2% rente.\")\n",
    "år_2 = måneder_2 // 12\n",
