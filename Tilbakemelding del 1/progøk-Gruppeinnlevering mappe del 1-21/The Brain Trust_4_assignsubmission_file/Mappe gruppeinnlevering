    "import numpy as np\n",
    "import random\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Definere produktene med pris og base sannsynlighet for kjøp\n",
    "products = {\n",
    "    'produkt1': {'price': 100, 'base_prob': 0.2},\n",
    "    'produkt2': {'price': 200, 'base_prob': 0.15},\n",
    "    'produkt3': {'price': 50, 'base_prob': 0.3},\n",
    "    'produkt4': {'price': 500, 'base_prob': 0.05}\n",
    "}\n",
    "\n",
    "# Parametre for simuleringen\n",
    "num_days = 30\n",
    "customers_per_day = 50\n",
    "sale_discount = 0.2  # 20% rabatt på produktene når de er på tilbud\n",
    "sale_increase_factor = 1.5  # Øker kjøpssannsynligheten ved tilbud\n",
    "\n",
    "# Kundens budsjett trekkes fra en normalfordeling\n",
    "def generate_budget():\n",
    "    return random.gauss(400, 100)  # Økt til et gjennomsnitt på 400\n",
    "\n",
    "# Simulere kjøpssannsynlighet\n",
    "def purchase_decision(budget, product_price, base_prob, on_sale=False):\n",
    "    if on_sale:\n",
    "        # Øk sannsynligheten direkte ved tilbud, med en begrensning på 1 (100% sannsynlighet)\n",
    "        prob = min(base_prob * sale_increase_factor, 1)\n",
    "    else:\n",
    "        prob = base_prob\n",
    "    \n",
    "    if budget >= product_price and random.random() < prob:\n",
    "        return True  # Kunden kjøper produktet\n",
    "    return False\n",
    "\n",
    "# Simulere én dag med salg\n",
    "def simulate_day(on_sale=False):\n",
    "    total_sales = 0\n",
    "    total_revenue = 0\n",
    "    \n",
    "    for _ in range(customers_per_day):\n",
    "        budget = generate_budget()\n",
    "        for product, info in products.items():\n",
    "            price = info['price'] * (1 - sale_discount) if on_sale else info['price']\n",
    "            if purchase_decision(budget, price, info['base_prob'], on_sale):\n",
    "                total_sales += 1\n",
    "                total_revenue += price\n",
    "                budget -= price  # Reduser budsjettet etter kjøpet\n",
    "    \n",
    "    return total_sales, total_revenue\n",
    "\n",
    "# Simulere en måned (30 dager) med og uten tilbud\n",
    "def simulate_month(on_sale=False):\n",
    "    total_sales = []\n",
    "    total_revenue = []\n",
    "    \n",
    "    for _ in range(num_days):\n",
    "        sales, revenue = simulate_day(on_sale)\n",
    "        total_sales.append(sales)\n",
    "        total_revenue.append(revenue)\n",
    "    \n",
    "    return total_sales, total_revenue\n",
    "\n",
    "# Kjøre simulering for begge scenarier\n",
    "sales_no_sale, revenue_no_sale = simulate_month(on_sale=False)\n",
    "sales_on_sale, revenue_on_sale = simulate_month(on_sale=True)\n",
    "\n",
    "# Tekstutskrift - Sammendrag av simuleringen\n",
    "total_sales_no_sale = sum(sales_no_sale)\n",
    "total_revenue_no_sale = sum(revenue_no_sale)\n",
    "average_sales_no_sale = np.mean(sales_no_sale)\n",
    "average_revenue_no_sale = np.mean(revenue_no_sale)\n",
    "\n",
    "total_sales_on_sale = sum(sales_on_sale)\n",
    "total_revenue_on_sale = sum(revenue_on_sale)\n",
    "average_sales_on_sale = np.mean(sales_on_sale)\n",
    "average_revenue_on_sale = np.mean(revenue_on_sale)\n",
    "\n",
    "print(\"Resultater uten tilbud:\")\n",
    "print(f\"Totalt antall solgte varer: {total_sales_no_sale}\")\n",
    "print(f\"Total omsetning: {total_revenue_no_sale:.2f} kr\")\n",
    "print(f\"Gjennomsnittlig antall solgte varer per dag: {average_sales_no_sale:.2f}\")\n",
    "print(f\"Gjennomsnittlig omsetning per dag: {average_revenue_no_sale:.2f} kr\\n\")\n",
    "\n",
    "print(\"Resultater med tilbud:\")\n",
    "print(f\"Totalt antall solgte varer: {total_sales_on_sale}\")\n",
    "print(f\"Total omsetning: {total_revenue_on_sale:.2f} kr\")\n",
    "print(f\"Gjennomsnittlig antall solgte varer per dag: {average_sales_on_sale:.2f}\")\n",
    "print(f\"Gjennomsnittlig omsetning per dag: {average_revenue_on_sale:.2f} kr\\n\")\n",
    "\n",
    "# Sammenligning mellom de to scenariene\n",
    "diff_sales = total_sales_on_sale - total_sales_no_sale\n",
    "diff_revenue = total_revenue_on_sale - total_revenue_no_sale\n",
    "\n",
    "print(\"Sammenligning:\")\n",
    "print(f\"Økning i totalt antall solgte varer med tilbud: {diff_sales}\")\n",
    "print(f\"Økning i total omsetning med tilbud: {diff_revenue:.2f} kr\")\n",
    "\n",
    "# Visualisere resultatene\n",
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "# Omsetning per dag\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.plot(revenue_no_sale, label='Uten tilbud')\n",
    "plt.plot(revenue_on_sale, label='Med tilbud')\n",
    "plt.title('Omsetning per dag')\n",
    "plt.xlabel('Dag')\n",
    "plt.ylabel('Omsetning (kr)')\n",
    "plt.legend()\n",
    "\n",
    "# Antall solgte varer per dag\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.plot(sales_no_sale, label='Uten tilbud')\n",
