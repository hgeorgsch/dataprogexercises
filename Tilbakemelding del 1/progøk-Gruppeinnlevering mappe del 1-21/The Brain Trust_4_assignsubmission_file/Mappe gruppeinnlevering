    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Sparekalkulator funksjoner\n",
    "\n",
    "def sparing_for_1000000(år, rente):\n",
    "    målbeløp = 1000000\n",
    "    måneder = år * 12\n",
    "    månedsrente = rente / 12 / 100\n",
    "    månedlig_sparing = målbeløp * månedsrente / ((1 + månedsrente) ** måneder - 1)\n",
    "    return månedlig_sparing\n",
    "\n",
    "def saldo_over_tid(månedlig_sparing, måneder, rente):\n",
    "    saldo = 0\n",
    "    saldoer = []\n",
    "    månedsrente = rente / 12 / 100\n",
    "    for måned in range(måneder):\n",
    "        saldo = saldo * (1 + månedsrente) + månedlig_sparing\n",
    "        saldoer.append(saldo)\n",
    "    return saldoer\n",
    "\n",
    "def tid_for_1500000(månedlig_sparing, rente):\n",
    "    målbeløp = 1500000\n",
    "    månedsrente = rente / 12 / 100\n",
    "    saldo = 0\n",
    "    måneder = 0\n",
    "    saldoer = []\n",
    "    while saldo < målbeløp:\n",
    "        saldo = saldo * (1 + månedsrente) + månedlig_sparing\n",
    "        saldoer.append(saldo)\n",
    "        måneder += 1\n",
    "    return måneder, saldoer\n",
    "\n",
    "def endring_i_sparing(målbeløp, nåværende_rente, ny_rente, månedlig_sparing, år):\n",
    "    måneder = år * 12\n",
    "    månedsrente_nåværende = nåværende_rente / 12 / 100\n",
    "    månedsrente_ny = ny_rente / 12 / 100\n",
    "\n",
    "    saldo_nåværende = månedlig_sparing * ((1 + månedsrente_nåværende) ** måneder - 1) / månedsrente_nåværende\n",
    "    nytt_månedlig_sparing = målbeløp * månedsrente_ny / ((1 + månedsrente_ny) ** måneder - 1)\n",
    "\n",
    "    endring = nytt_månedlig_sparing - månedlig_sparing\n",
    "    return endring\n",
    "\n",
    "# Data for Scenario 1\n",
    "år_1 = 10\n",
    "rente_1 = 2\n",
    "månedlig_sparing_1 = sparing_for_1000000(år_1, rente_1)\n",
    "måneder_1 = år_1 * 12\n",
    "saldoer_1 = saldo_over_tid(månedlig_sparing_1, måneder_1, rente_1)\n",
    "\n",
    "# Data for Scenario 2\n",
    "månedlig_sparing_2 = 10000\n",
    "rente_2 = 2\n",
    "måneder_2, saldoer_2 = tid_for_1500000(månedlig_sparing_2, rente_2)\n",
