def beregn_terminbelop(sluttbelop, rente, antall_perioder):
    terminbelop = sluttbelop * rente / ((1 + rente) ** antall_perioder - 1)
    return terminbelop

def beregn_antall_perioder(sluttbelop, terminbelop, rente):
    antall_perioder = (sluttbelop / terminbelop) * rente + 1
    return antall_perioder

def juster_terminbelop_ved_renteendring(sluttbelop, eksisterende_terminbelop, gammel_rente, ny_rente, antall_perioder):
    nytt_terminbelop = sluttbelop * ny_rente / ((1 + ny_rente) ** antall_perioder - 1)
    endring_i_terminbelop = nytt_terminbelop - eksisterende_terminbelop
    return nytt_terminbelop, endring_i_terminbelop
sluttbelop = 100000  
rente = 0.05 / 12  
antall_perioder = 12 * 5  
eksisterende_terminbelop = 1500 

terminbelop = beregn_terminbelop(sluttbelop, rente, antall_perioder)
print("Du må spare " + str(round(terminbelop, 2)) + " kr per måned for å nå målet.")

antall_mnd = beregn_antall_perioder(sluttbelop, eksisterende_terminbelop, rente)
print("Du må spare i " + str(round(antall_mnd, 2)) + " måneder for å nå målet.")

ny_rente = 0.06 / 12 
nytt_terminbelop, endring = juster_terminbelop_ved_renteendring(sluttbelop, eksisterende_terminbelop, rente, ny_rente, antall_perioder)
print("Med den nye renten må du spare " + str(round(nytt_terminbelop, 2)) + " kr per måned, en endring på " + str(round(endring, 2)) + " kr.")
