    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "def forrentning(r, t, S):\n",
    "    return S*t**(1+r)\n",
    "rente = np.linspace(0, 1,100)\n",
    "t = np.linspace (0,5,1000)\n",
    "S = np.linspace(0,100000)\n",
    "plt.plot(t, forrentning(0.43,t,1000))\n",
    "plt.show()"
