@misc{hgs2024icds,
title = {On Human Sovereignty in a Digital Age},
journal = {Procedia Computer Science},
volume = {254},
pages = {157-163},
year = 2025,
note = {International Conference on Digital Sovereignty (ICDS)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.02.074},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925004247},
author = {Rituka Jaiswal and Hans Georg Schaathun},
  ownfile = {hgs24icds.pdf},
keywords = {Sovereignty, Digital Sovereignty, Education, Technical Rationality, Alienation},
abstract = {Sovereignty of the state has evolved as an important means to protect the security and freedom of people. An important question is how this sovereignty can be sustained in a digital world. This is commonly known as digital sovereignty. An equally important question is if digital sovereignty can successfully protect the freedom, privacy, and human rights of the citizen, or if other means have to be sought. In particular, we ask if laws and regulations can solve the problems of digital and human sovereignty or if they make matters worse. In light of the history of ideas, we try to clarify the meaning of sovereignty in general and digital sovereignty in particular, as well as the rights and freedoms that sovereignty is assumed to protect. This leads to the conception of human sovereignty, considering not only the sovereignty of the state in the face of multinational corporations and other states, but also the sovereignty of humankind in face of technology itself, and digital technology and artificial intelligence in particular.}
}
